PORT=3060

# JWT Configuration
JWT_SECRET=local-dev-secret-key-change-me
JWT_EXPIRY=30m
JWT_ISSUER=nestjs-auth-service
JWT_PRIVATE_KEY=local-dev-private-key
JWT_REFRESH_PRIVATE_KEY=local-dev-refresh-private-key
JWT_REFRESH_EXPIRY=24h

# Twilio Configuration (for SMS validation)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SID=your-twilio-verify-sid

# Security Configuration
SALT_ROUND=10

# MongoDB Configuration
MONGODB=your-mongodb-connection-string

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Leonardo AI Configuration
LEONARDO_API_KEY=your-leonardo-api-key
LEONARDO_API_BASE_URL=https://cloud.leonardo.ai/api/rest/v1

# Remove.bg Configuration
REMOVE_BG_API_KEY=your-remove-bg-api-key

# CORS Configuration
CORS_ORIGIN=http://localhost:4200
