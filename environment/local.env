DATABASE_URL=postgresql://postgres:postgres@localhost:5432/base-project-service

# JWT Configuration
JWT_SECRET=local-dev-secret-key-change-me
JWT_EXPIRY=30m
JWT_ISSUER=nestjs-auth-service
JWT_PRIVATE_KEY=local-dev-private-key

# Twilio Configuration (for SMS validation)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SID=your-twilio-verify-sid

# Security Configuration
SALT_ROUND=10